# ==============================================================================
# KAUDAL FINANZAS PERSONALES — VARIABLES DE ENTORNO (.env.example)
# Nunca expongas claves secretas (SUPABASE_SERVICE_ROLE_KEY, OAuth Client Secret)
# en variables públicas del cliente ni las subas al repositorio Git.
# ==============================================================================

# 1. SUPABASE (Cliente Público - Seguro con Row Level Security activo)
VITE_SUPABASE_URL="https://tu-proyecto-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.tu-anon-key-publica"

# Clave privada de administración (SOLO SERVIDOR / EDGE FUNCTIONS - NUNCA EN CLIENTE)
SUPABASE_SERVICE_ROLE_KEY="REEMPLAZAR_SOLO_EN_ENTORNO_SERVIDOR"

# 2. GOOGLE MAPS PLATFORM (Restringir por HTTP Referrer y por API en Google Cloud Console)
# APIs habilitadas: Maps JavaScript API, Places API (New), Geocoding API
VITE_GOOGLE_MAPS_API_KEY="AIzaSy_TU_API_KEY_RESTRINGIDA_POR_DOMINIO"
VITE_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# 3. CONFIGURACIÓN DE LA APLICACIÓN
APP_URL="http://localhost:3000"
VITE_DEFAULT_CURRENCY="USD"

